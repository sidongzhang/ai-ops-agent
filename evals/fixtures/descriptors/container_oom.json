{
  "id": "eval-docker-local",
  "name": "eval-docker-local 本地演示栈（容器 OOMKill 场景）",
  "local": true,
  "infra": {
    "prometheus_url": "http://127.0.0.1:9090",
    "prometheus": { "url": "http://127.0.0.1:9090" }
  },
  "services": [
    {
      "name": "Kafka",
      "connector": "local",
      "kind": "docker",
      "config": { "container": "ai-ops-agent-kafka-1" },
      "container": "ai-ops-agent-kafka-1",
      "runtime": { "container": "ai-ops-agent-kafka-1", "systemd_unit": "", "selector": "" }
    },
    {
      "name": "Prometheus",
      "connector": "prometheus",
      "config": { "url": "http://127.0.0.1:9090" },
      "url": "http://127.0.0.1:9090",
      "up_query": "up",
      "runtime": { "container": "ai-ops-agent-prometheus-1", "systemd_unit": "", "selector": "" }
    },
    {
      "name": "API",
      "connector": "local",
      "kind": "process",
      "config": {
        "log_file": "evals/fixtures/logs/api-oom.log",
        "pid_file": "pids/api.pid"
      },
      "log_file": "evals/fixtures/logs/api-oom.log",
      "health_url": "http://127.0.0.1:8000/health",
      "runtime": { "container": "", "systemd_unit": "", "selector": "" }
    }
  ]
}
