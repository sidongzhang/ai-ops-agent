backend/archive/
agent/chroma_db/
backend/app/agent/diagnostics/knowledge/docs/*
!backend/app/agent/diagnostics/knowledge/docs/.gitkeep
logs/
pids/
.dev-stack/
*.log
*.db

# node / frontend build
node_modules/
dist/
dist-prod/
# 锁文件必须入库：CI 用 `npm ci` 复现前端构建

# editors / OS
.idea/
.vscode/
.cursor/
.DS_Store

# PyInstaller build artifacts
build/

# Native Pi SQLite journal sidecars
*.db-wal
*.db-shm
