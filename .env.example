# ── LLM：本地部署 / 远程 API 二选一 ───────────────────────
# api   = 远程 OpenAI 兼容 API（DeepSeek / OpenAI / 通义 / 智谱等）
# local = 本地 OpenAI 兼容服务（Ollama / vLLM / LM Studio 等）
LLM_MODE=api

# 远程 API 示例：DeepSeek
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_MODEL=deepseek-chat

# 本地部署示例：Ollama。低内存 Docker 默认用 0.5b；内存充足时可切到 3b/7b。
# 启动示例：scripts/setup-local-llm.sh
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen2.5:0.5b

# 旧变量仍兼容；新部署建议使用 LLM_*。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# ── 控制面鉴权 ────────────────────────────────────────────
# JWT 签名密钥（生产必须替换为强随机值）
JWT_SECRET=change-me-in-production

# ── 凭据字段加密（Fernet AES-128）────────────────────────
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# dev 可留空（跳过加密）；生产必须设置并妥善保管，密钥丢失已加密数据无法恢复
ENCRYPTION_KEY=

# ── 数据库 ────────────────────────────────────────────────
# dev 默认 SQLite（无需设置）
# 生产切换 PostgreSQL：
# 数据库：dev 与生产统一使用 Postgres（pgvector/pgvector:pg16）
# 启动：docker compose -f deploy/docker-compose.yml up -d platform-db
DATABASE_URL=postgresql+psycopg2://ops:opspass@localhost:5432/controlplane
# 历史开发库数据迁移：backend/scripts/migrate_sqlite_to_pg.py
# 不设置时回退 SQLite dev.db（仅作无 Docker 时的兜底）

# ── Celery 定时巡检 ───────────────────────────────────────
# Broker/Backend（deploy/docker-compose.yml 里的 platform-redis，宿主机映射 6380）
# ⚠️ 本地 dev（根目录 docker-compose.yml）的 Redis 在 6379，不是 6380。
#    如果 API 与 worker 指向不同 Redis，消息中心会大量出现"分析失败 / enqueue_failed"。
#    本地开发请改成 redis://127.0.0.1:6379/0 与 /1，或直接用 scripts/dev-stack.sh 启动（会自动注入）。
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
# 巡检周期（秒，默认 60）
HEALTH_CHECK_INTERVAL=60
# 同一系统两次告警最小间隔（秒，默认 3600）
ALERT_COOLDOWN_SECONDS=3600

# ── RAG 知识库 Embedding API（OpenAI 兼容）──────────────────
# 留空则复用当前 LLM_MODE 对应的 base_url / api_key
# 本地 Ollama 可填 nomic-embed-text；API 可填 text-embedding-v2 / text-embedding-3-small
EMBEDDING_MODEL=text-embedding-v2
# EMBEDDING_API_KEY=     # 空则复用当前 LLM API key
# EMBEDDING_BASE_URL=    # 空则复用当前 LLM base URL
# 向量维度：必须与 embedding 模型一致（nomic-embed-text=768，text-embedding-v2=1536）；
# 修改后需重建知识库索引（删除 knowledge_chunks/knowledge_index_meta 该系统数据即可自动重建）
# EMBEDDING_DIM=1536
# 知识库文档放在：backend/app/agent/diagnostics/knowledge/docs/<system_id>/
# 每次诊断后自动追加摘要到 runbook.md；embedding API 不可用时降级关键词检索

# ── Langfuse 可观测性（留空跳过追踪）────────────────────────
# 在 https://cloud.langfuse.com 注册或自托管后填入
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 模型路由（高危问题升档）─────────────────────────────────
# 触发词：P0/崩溃/宕机/数据丢失/紧急/生产故障 等
# 升档后走此模型（OpenAI 兼容）。留空则按当前 LLM_MODE 复用默认配置。
ADVANCED_AGENT_MODEL=deepseek-reasoner
# ADVANCED_AGENT_BASE_URL=   # 空则复用 deepseek 地址
# ADVANCED_AGENT_API_KEY=    # 空则复用 deepseek 密钥
# ADVANCED_LLM_MODE=api
# ADVANCED_LLM_API_BASE_URL=https://api.deepseek.com
# ADVANCED_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ADVANCED_LLM_API_MODEL=deepseek-reasoner
# ADVANCED_LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# ADVANCED_LLM_LOCAL_API_KEY=ollama
# ADVANCED_LLM_LOCAL_MODEL=qwen2.5:3b
