:80 {
	# 压缩：经过 cloudflared 隧道访问时，前端资源 1.4MB -> ~440KB（省 68%）
	encode zstd gzip

	# 后端 API
	@api {
		path /auth/*
		path /systems*
		path /collectors*
		path /collector*
		path /workflows*
		path /messages*
		path /audit*
		path /analytics*
		path /openapi/*
		path /incidents*
		path /healthz
		path /ws*
		path /feishu*
	}
	handle @api {
		reverse_proxy localhost:8000
	}

	root * /Users/zhangsidong/ai-ops-agent/frontend/dist-prod

	# 静态资源：带 hash 的文件可长期缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /favicon.svg {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# SPA 入口：禁止缓存，避免 HTML 指向已删除的旧 JS
	handle {
		header Cache-Control "no-store, no-cache, must-revalidate"
		header Pragma "no-cache"
		try_files {path} /index.html
		file_server
	}
}
